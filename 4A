import 'package:flutter/material.dart';

void main() {
  runApp(const ResponsiveGalleryApp());
}

// Classify screen size
String getDeviceCategory(double width) {
  if (width < 600) {
    return 'Mobile';
  } else if (width < 1024) {
    return 'Tablet';
  } else {
    return 'Desktop';
  }
}

class ResponsiveGalleryApp extends StatelessWidget {
  const ResponsiveGalleryApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Responsive Gallery',
      theme: ThemeData(
        colorSchemeSeed: Colors.deepPurple,
        useMaterial3: true,
      ),
      home: const GalleryScreen(),
    );
  }
}

class GalleryScreen extends StatelessWidget {
  const GalleryScreen({super.key});

  final List<Map<String, dynamic>> items = const [
    {
      'title': 'Nature',
      'subtitle': 'Explore beautiful landscapes',
      'icon': Icons.landscape,
      'color': Color(0xFFD8F3DC),
    },
    {
      'title': 'Technology',
      'subtitle': 'Discover new innovations',
      'icon': Icons.computer,
      'color': Color(0xFFDDE7FF),
    },
    {
      'title': 'Travel',
      'subtitle': 'Visit amazing destinations',
      'icon': Icons.flight,
      'color': Color(0xFFFFE5D9),
    },
    {
      'title': 'Photography',
      'subtitle': 'Capture special moments',
      'icon': Icons.camera_alt,
      'color': Color(0xFFF3DDF7),
    },
    {
      'title': 'Education',
      'subtitle': 'Learn something new',
      'icon': Icons.school,
      'color': Color(0xFFFFF1C1),
    },
    {
      'title': 'Music',
      'subtitle': 'Enjoy your favorite tunes',
      'icon': Icons.music_note,
      'color': Color(0xFFD5F5F5),
    },
  ];

  @override
  Widget build(BuildContext context) {
    final media = MediaQuery.of(context);
    final screenWidth = media.size.width;

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Responsive Gallery',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),
        backgroundColor: Colors.deepPurple,
        foregroundColor: Colors.white,
      ),

      // LayoutBuilder determines the available screen width
      body: LayoutBuilder(
        builder: (context, constraints) {
          final width = constraints.maxWidth;
          final category = getDeviceCategory(width);

          final isDesktop = width >= 1024;
          final isTablet = width >= 600 && width < 1024;

          return OrientationBuilder(
            builder: (context, orientation) {
              final isLandscape =
                  orientation == Orientation.landscape;

              // Mobile landscape uses horizontal scrolling
              if (!isTablet && !isDesktop && isLandscape) {
                return Column(
                  children: [
                    Expanded(
                      child: Padding(
                        padding: const EdgeInsets.all(12),
                        child: ListView.builder(
                          scrollDirection: Axis.horizontal,
                          itemCount: items.length,
                          itemBuilder: (context, index) {
                            return SizedBox(
                              width: 240,
                              child: GalleryCard(
                                item: items[index],
                                horizontal: true,
                              ),
                            );
                          },
                        ),
                      ),
                    ),
                    DebugFooter(
                      width: screenWidth,
                      category: category,
                      orientation: 'Landscape',
                    ),
                  ],
                );
              }

              // Desktop layout with navigation rail
              if (isDesktop) {
                return Row(
                  children: [
                    NavigationRail(
                      selectedIndex: 0,
                      onDestinationSelected: (index) {},
                      labelType: NavigationRailLabelType.all,
                      destinations: const [
                        NavigationRailDestination(
                          icon: Icon(Icons.home),
                          label: Text('Home'),
                        ),
                        NavigationRailDestination(
                          icon: Icon(Icons.grid_view),
                          label: Text('Gallery'),
                        ),
                        NavigationRailDestination(
                          icon: Icon(Icons.settings),
                          label: Text('Settings'),
                        ),
                      ],
                    ),
                    Expanded(
                      child: Column(
                        children: [
                          Expanded(
                            child: GalleryGrid(
                              items: items,
                              columns: 3,
                              padding: 24,
                              textSize: 20,
                            ),
                          ),
                          DebugFooter(
                            width: screenWidth,
                            category: category,
                            orientation: isLandscape
                                ? 'Landscape'
                                : 'Portrait',
                          ),
                        ],
                      ),
                    ),
                  ],
                );
              }

              // Mobile portrait and tablet layouts
              final columns = isTablet ? 2 : 1;

              final padding = isTablet
                  ? (isLandscape ? 24.0 : 16.0)
                  : 12.0;

              final textSize = isTablet && isLandscape ? 20.0 : 16.0;

              return Column(
                children: [
                  Expanded(
                    child: GalleryGrid(
                      items: items,
                      columns: columns,
                      padding: padding,
                      textSize: textSize,
                    ),
                  ),
                  DebugFooter(
                    width: screenWidth,
                    category: category,
                    orientation: isLandscape
                        ? 'Landscape'
                        : 'Portrait',
                  ),
                ],
              );
            },
          );
        },
      ),
    );
  }
}

// Responsive grid for mobile portrait, tablet, and desktop
class GalleryGrid extends StatelessWidget {
  final List<Map<String, dynamic>> items;
  final int columns;
  final double padding;
  final double textSize;

  const GalleryGrid({
    super.key,
    required this.items,
    required this.columns,
    required this.padding,
    required this.textSize,
  });

  @override
  Widget build(BuildContext context) {
    return GridView.builder(
      padding: EdgeInsets.all(padding),
      itemCount: items.length,
      gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
        crossAxisCount: columns,
        crossAxisSpacing: padding,
        mainAxisSpacing: padding,
        childAspectRatio: columns == 1 ? 2.0 : 1.25,
      ),
      itemBuilder: (context, index) {
        return GalleryCard(
          item: items[index],
          textSize: textSize,
        );
      },
    );
  }
}

// Individual gallery card
class GalleryCard extends StatelessWidget {
  final Map<String, dynamic> item;
  final double textSize;
  final bool horizontal;

  const GalleryCard({
    super.key,
    required this.item,
    this.textSize = 16,
    this.horizontal = false,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      color: item['color'] as Color,
      elevation: 3,
      margin: const EdgeInsets.all(8),
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(18),
      ),
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: horizontal
            ? Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Icon(
                    item['icon'] as IconData,
                    size: 65,
                    color: Colors.deepPurple,
                  ),
                  const SizedBox(height: 16),
                  Text(
                    item['title'] as String,
                    textAlign: TextAlign.center,
                    style: TextStyle(
                      fontSize: textSize + 4,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  const SizedBox(height: 8),
                  Text(
                    item['subtitle'] as String,
                    textAlign: TextAlign.center,
                    style: TextStyle(fontSize: textSize),
                  ),
                ],
              )
            : Row(
                children: [
                  Icon(
                    item['icon'] as IconData,
                    size: 45,
                    color: Colors.deepPurple,
                  ),
                  const SizedBox(width: 16),
                  Expanded(
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          item['title'] as String,
                          style: TextStyle(
                            fontSize: textSize,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                        const SizedBox(height: 6),
                        Flexible(
                          child: Text(
                            item['subtitle'] as String,
                            style: const TextStyle(fontSize: 13),
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
      ),
    );
  }
}

// Footer showing responsive layout information
class DebugFooter extends StatelessWidget {
  final double width;
  final String category;
  final String orientation;

  const DebugFooter({
    super.key,
    required this.width,
    required this.category,
    required this.orientation,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.symmetric(
        vertical: 12,
        horizontal: 8,
      ),
      color: Colors.deepPurple,
      child: Column(
        children: [
          Text(
            'Device: $category | Orientation: $orientation',
            textAlign: TextAlign.center,
            style: const TextStyle(
              color: Colors.white,
              fontWeight: FontWeight.bold,
            ),
          ),
          const SizedBox(height: 4),
          Text(
            'Screen Width: ${width.toStringAsFixed(0)} px',
            style: const TextStyle(color: Colors.white70),
          ),
        ],
      ),
    );
  }
}
